#!/usr/bin/env python3
"""Render bounded STL meshes as transparent PNG thumbnails."""
from array import array
import math
import os
import re
import struct
import sys
import zlib

DEFAULT_MAX_BYTES = 16 * 1024 * 1024
MAX_TRIANGLES = 500_000
MAX_RASTER_WORK = 40_000_000
MAX_LINE_BYTES = 4096
VERTEX = re.compile(rb"\bvertex\s+([-+\d.eE]+)\s+([-+\d.eE]+)\s+([-+\d.eE]+)", re.I)


def triangles_from_stl(path, max_bytes):
    size = os.stat(path).st_size
    if size > max_bytes:
        raise ValueError(f"File is larger than the configured {max_bytes // (1024 * 1024)} MiB limit")
    with open(path, "rb") as stream:
        header = stream.read(84)
        if len(header) == 84:
            count = struct.unpack_from("<I", header, 80)[0]
            if 84 + count * 50 == size:
                if count > MAX_TRIANGLES:
                    raise ValueError("STL exceeds the triangle limit")
                for _ in range(count):
                    record = stream.read(50)
                    if len(record) != 50:
                        raise ValueError("Truncated binary STL")
                    values = struct.unpack("<12fH", record)
                    triangle = (values[3:6], values[6:9], values[9:12])
                    if not all(math.isfinite(coordinate) for vertex in triangle for coordinate in vertex):
                        raise ValueError("STL contains non-finite coordinates")
                    yield triangle
                return

    # ASCII STL is streamed one bounded line at a time. Keeping only one facet's
    # vertices avoids materializing the whole text file or its mesh.
    vertices = []
    triangles = 0
    with open(path, "rb") as stream:
        consumed = 0
        while True:
            line = stream.readline(MAX_LINE_BYTES + 1)
            if not line:
                break
            consumed += len(line)
            if consumed > max_bytes:
                raise ValueError("STL grew beyond the configured file size limit")
            if len(line) > MAX_LINE_BYTES:
                raise ValueError("STL contains an unusually long line")
            match = VERTEX.search(line)
            if not match:
                continue
            vertex = tuple(float(value) for value in match.groups())
            if not all(math.isfinite(coordinate) for coordinate in vertex):
                raise ValueError("STL contains non-finite coordinates")
            vertices.append(vertex)
            if len(vertices) == 3:
                triangles += 1
                if triangles > MAX_TRIANGLES:
                    raise ValueError("STL exceeds the triangle limit")
                yield tuple(vertices)
                vertices = []
    if vertices or triangles == 0:
        raise ValueError("Not a readable STL mesh")


def png(path, w, h, rgba):
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff)
    raw = b"".join(b"\0" + bytes(rgba[y * w * 4:(y + 1) * w * 4]) for y in range(h))
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">2I5B", w, h, 8, 6, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(raw, 8)))
        f.write(chunk(b"IEND", b""))


def project(vertex, center, ca, sa, ce, se):
    x, y, z = (vertex[i] - center[i] for i in range(3))
    horizontal = sa * x + ca * y
    return ca * x - sa * y, se * horizontal + ce * z, -ce * horizontal + se * z


def main():
    src, dst = sys.argv[1], sys.argv[2]
    size = max(64, min(int(sys.argv[3]) if len(sys.argv) > 3 else 256, 1024))
    max_bytes = int(sys.argv[4]) if len(sys.argv) > 4 else DEFAULT_MAX_BYTES
    if max_bytes <= 0:
        raise ValueError("Invalid file size limit")

    # First pass computes the mesh bounds without retaining its triangles.
    lo, hi = [float("inf")] * 3, [float("-inf")] * 3
    triangle_count = 0
    for triangle in triangles_from_stl(src, max_bytes):
        triangle_count += 1
        for vertex in triangle:
            for axis in range(3):
                lo[axis] = min(lo[axis], vertex[axis])
                hi[axis] = max(hi[axis], vertex[axis])
    if not triangle_count:
        raise ValueError("STL contains no triangles")
    center = [(lo[i] + hi[i]) / 2 for i in range(3)]
    az, el = math.radians(42), math.radians(28)
    ca, sa, ce, se = math.cos(az), math.sin(az), math.cos(el), math.sin(el)

    # Projection is affine, so extrema are found among the eight bounding-box corners.
    bounds = [project((x, y, z), center, ca, sa, ce, se)
              for x in (lo[0], hi[0]) for y in (lo[1], hi[1]) for z in (lo[2], hi[2])]
    xmin, xmax = min(p[0] for p in bounds), max(p[0] for p in bounds)
    ymin, ymax = min(p[1] for p in bounds), max(p[1] for p in bounds)
    span = max(xmax - xmin, ymax - ymin, 1e-12)
    scale = (size * .82) / span
    ox = size / 2 - (xmin + xmax) * scale / 2
    oy = size / 2 + (ymin + ymax) * scale / 2

    image = bytearray(size * size * 4)
    depth = array("f", [float("-inf")]) * (size * size)
    light = (0.35, -0.45, 0.82)
    ll = math.sqrt(sum(x*x for x in light))
    light = tuple(x / ll for x in light)
    raster_work = 0

    # Second pass projects and rasterizes one triangle at a time.
    for triangle in triangles_from_stl(src, max_bytes):
        projected = [project(vertex, center, ca, sa, ce, se) for vertex in triangle]
        p = [(ox + x * scale, oy - y * scale, z) for x, y, z in projected]
        (x1, y1, z1), (x2, y2, z2), (x3, y3, z3) = p
        area = (x2-x1)*(y3-y1) - (y2-y1)*(x3-x1)
        if abs(area) < 1e-8:
            continue
        minx, maxx = max(0, int(min(x1, x2, x3))), min(size - 1, int(max(x1, x2, x3)) + 1)
        miny, maxy = max(0, int(min(y1, y2, y3))), min(size - 1, int(max(y1, y2, y3)) + 1)
        raster_work += max(0, maxx - minx + 1) * max(0, maxy - miny + 1)
        if raster_work > MAX_RASTER_WORK:
            raise ValueError("STL exceeds the thumbnail rendering work limit")

        a, b, c = triangle
        u = [b[i] - a[i] for i in range(3)]
        v = [c[i] - a[i] for i in range(3)]
        normal = (u[1]*v[2]-u[2]*v[1], u[2]*v[0]-u[0]*v[2], u[0]*v[1]-u[1]*v[0])
        nl = math.sqrt(sum(q*q for q in normal)) or 1
        diffuse = abs(sum(normal[i] * light[i] for i in range(3)) / nl)
        shade = int(105 + 130 * diffuse)
        color = bytes((shade, int(shade * .72), int(shade * .48), 255))
        for py in range(miny, maxy + 1):
            for px in range(minx, maxx + 1):
                xx, yy = px + .5, py + .5
                w1 = ((x2-xx)*(y3-yy) - (y2-yy)*(x3-xx)) / area
                w2 = ((x3-xx)*(y1-yy) - (y3-yy)*(x1-xx)) / area
                w3 = 1 - w1 - w2
                if min(w1, w2, w3) >= -1e-8:
                    idx = py * size + px
                    z = w1*z1 + w2*z2 + w3*z3
                    if z > depth[idx]:
                        depth[idx] = z
                        offset = idx * 4
                        image[offset:offset+4] = color
    png(dst, size, size, image)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print("stl-thumbnailer:", exc, file=sys.stderr)
        sys.exit(1)
